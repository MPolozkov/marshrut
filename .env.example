# --- База и очереди ---
DATABASE_URL=postgres://marshrut:marshrut@localhost:5433/marshrut
REDIS_URL=redis://localhost:6379

# --- Безопасность ---
JWT_SECRET=поменяйте-на-длинную-случайную-строку
JWT_EXPIRES_IN=7d

# --- Сервер ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Публичный адрес веб-кабинета (для ссылок трекинга в уведомлениях)
PUBLIC_URL=http://localhost:5173

# --- Уведомления (пустое значение = канал выключен, сообщения пишутся в лог) ---
TELEGRAM_BOT_TOKEN=
# Бот в Max: токен и базовый адрес API из кабинета разработчика Max
MAX_BOT_TOKEN=
MAX_API_URL=
# SMSC.ru
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=

# --- Панель владельца платформы (/platform). Пусто = панель выключена ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Подсказки городов по всей России (необязательно): ключ API DaData, dadata.ru ---
DADATA_API_KEY=

# --- Координаты по адресу (необязательно): ключ JavaScript API и HTTP Геокодера Яндекса ---
# Нужен, чтобы заказ из приложения клиента уходил ближайшему курьеру, даже если клиент
# ввёл адрес забора вручную. Без ключа: ближайший по геопозиции «Я сейчас здесь», иначе наименее загруженный в городе.
YANDEX_GEOCODER_KEY=

# --- Почта техподдержки: обращения и заявки на подключение ---
SUPPORT_EMAIL=pipl82308@gmail.com
# SMTP для отправки писем. Пример для Gmail: smtp.gmail.com, порт 465, пароль приложения (не обычный пароль!)
# Для Яндекс 360: smtp.yandex.ru, 465. Без SMTP_HOST обращения сохраняются и видны в /platform, но письма не уходят.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Оплата картой (ЮKassa). Без ключей — тестовый режим: деньги не списываются, карта «•••• 4242» ---
# Ключи: личный кабинет ЮKassa → Интеграция → Ключи API. HTTP-уведомления: https://ваш-домен/api/client/payments/webhook
# (события payment.waiting_for_capture, payment.succeeded, payment.canceled).
# Списания с сохранённой карты без участия заказчика (автоплатежи) включает менеджер ЮKassa по заявке.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 1 — передавать чек по 54-ФЗ (если в ЮKassa подключена отправка чеков); ставка НДС: 1 — без НДС
YOOKASSA_RECEIPT=0
YOOKASSA_VAT_CODE=1
# Долг, при котором заказчик не может оформлять новые заказы (0 — любой долг блокирует)
DEBT_LIMIT_RUB=0
# Процент платформы с суммы каждого заказа; остальное — курьеру (50 → пополам)
PLATFORM_FEE_PERCENT=50
# Сколько минут ждать подтверждения банка (3-D Secure), потом неоплаченный заказ отменяется
PAY_WAIT_MINUTES=30
# Push-уведомления (Expo). Нужен, только если в настройках Expo включена защита отправки
EXPO_ACCESS_TOKEN=
# Часовой пояс для ночной надбавки (22:00–7:00)
TZ_CITY=Asia/Novosibirsk

# --- Выплаты курьерам-самозанятым (ЮKassa «Выплаты»: СБП + автоматический чек в «Мой налог») ---
# Отдельные ключи шлюза выплат. Без них — тестовый режим: выплата «проходит» сразу, деньги не переводятся.
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_SECRET=
MIN_PAYOUT_RUB=100
# «Доставлено» доступно курьеру не дальше этого расстояния от адреса, метров
DELIVER_RADIUS_M=300
# Тестовый режим: capture — после вручения списание «не проходит» (проверка долга); hold — банк отказывает в резерве
TEST_PAYMENTS_FAIL=
